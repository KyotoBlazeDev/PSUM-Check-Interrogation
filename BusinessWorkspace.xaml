<UserControl x:Class="PSUM_Check_Interrogation_WinUI_3.BusinessWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

 <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"><Grid HorizontalAlignment="Stretch"><StackPanel Padding="24" Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">
  <TextBlock Text="PSUM Check" FontSize="32" FontWeight="SemiBold" />
  <TextBlock Text="BUSINESS MODE • Battery maintenance workspace" FontSize="16" TextWrapping="Wrap" />
  <InfoBar x:Name="Message" IsOpen="False" IsClosable="True" />
  <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="RefreshButton" Content="Capture battery reading" Click="Refresh_Click" /><Button Content="Export JSON" Click="Json_Click" /><Button Content="Export CSV" Click="Csv_Click" /></StackPanel>
  <TextBlock x:Name="Dashboard" FontSize="18" TextWrapping="Wrap" />
  <TextBlock x:Name="Recommendation" TextWrapping="Wrap" FontWeight="SemiBold" />
  <TextBlock x:Name="Trend" TextWrapping="Wrap" />
  <TextBlock x:Name="Due" TextWrapping="Wrap" />
  <TextBlock Text="Asset and hardware provenance" FontSize="22" FontWeight="SemiBold" />
  <TextBlock Text="Record identifiers from the battery label or approved asset inventory. Do not open a sealed battery." TextWrapping="Wrap" />
  <TextBox x:Name="Asset" Header="Asset tag" MaxLength="128" /><TextBox x:Name="Manufacturer" Header="Battery manufacturer (label)" MaxLength="128" /><TextBox x:Name="Model" Header="Battery model (label)" MaxLength="128" /><TextBox x:Name="Serial" Header="Battery serial / inventory ID (label)" MaxLength="128" /><TextBox x:Name="Fru" Header="FRU / part number (label)" MaxLength="128" />
  <TextBlock Text="Physical inspection" FontSize="22" FontWeight="SemiBold" />
  <TextBlock Text="Unknown means not checked. All five observations are required to complete an inspection. Physical observations can be saved without telemetry; enter a battery serial / inventory ID when no previous asset record identifies the battery. Unavailable telemetry is recorded explicitly." TextWrapping="Wrap" />
  <ComboBox x:Name="Swelling" Header="Swelling" /><ComboBox x:Name="Heat" Header="Unusual heat" /><ComboBox x:Name="Leakage" Header="Leakage" /><ComboBox x:Name="Odor" Header="Unusual odor" /><ComboBox x:Name="Visual" Header="Visual condition" />
  <TextBox x:Name="Notes" Header="Evidence / service ticket / notes" AcceptsReturn="True" MaxLength="4000" />
  <NumberBox x:Name="Interval" Header="Next inspection in days" Value="90" Minimum="1" Maximum="365" SpinButtonPlacementMode="Inline" />
  <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="InspectionButton" Content="Record inspection" Click="Inspection_Click" /><Button x:Name="ReplacementButton" Content="Record battery replacement" Click="Replacement_Click" /></StackPanel>
  <TextBlock Text="Audit history" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Records are appended with the Windows account and timestamp. Corrections belong in a new record." TextWrapping="Wrap" />
  <TextBlock x:Name="History" TextWrapping="Wrap" />
  <Button Content="Open diagnostic logs" Click="Logs_Click" HorizontalAlignment="Left" />
  <TextBlock x:Name="AppMetadata" />
  <HyperlinkButton Content="Developer on GitHub" NavigateUri="https://github.com/KyotoBlazeDev" HorizontalAlignment="Left" />
 </StackPanel></Grid></ScrollViewer>
</UserControl>
